const categorias = ["Todos", "Lidos", "Lendo", "Quero ler"];
---

<Base title="Biblioteca | Syneidesis">
    <main class="biblioteca">
        <nav class="categorias">
            <button class="ativo" data-filtro="Todos">
                Todos
            </button>
            <button data-filtro="Lido">Lidos</button>
            <button data-filtro="Lendo">Lendo</button>
            <button data-filtro="Quero ler">Quero ler</button>
        </nav>

        <section class="estante">
            <h2>Minha estante</h2>

            <div class="livros">
                {livros.map((livro) => (
                    <article class="livro" data-status={livro.status}>
                        <div class="imagem-container">
                            <img
                                src={livro.capa}
                                alt={`Capa de ${livro.titulo}`}
                            />
                        </div>

                        <div class="informacoes">
                            <h3>{livro.titulo}</h3>
                            <p>{livro.autor}</p>
                            <span>{livro.status}</span>
                        </div>
                    </article>
                ))}
            </div>
        </section>
    </main>
</Base>

<script>
    const botoes = document.querySelectorAll(".categorias button");
    const livros = document.querySelectorAll(".livro");

    botoes.forEach((botao) => {
        botao.addEventListener("click", () => {
            const filtro = botao.dataset.filtro;

            botoes.forEach((b) => b.classList.remove("ativo"));
            botao.classList.add("ativo");

            livros.forEach((livro) => {
                const status = livro.getAttribute("data-status");

                livro.hidden = filtro !== "Todos" && status !== filtro;
            });
        });
    });
</script>

<style>
    .biblioteca {
        max-width: 100%;
    }

    header {
        margin-bottom: 2rem;
    }

    header p {
        opacity: 0.7;
    }

    .categorias {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
        margin-bottom: 3rem;
        border-bottom: 1px solid var(--border-color, #8884);
        padding-bottom: 1rem;
    }

    .categorias button {
        background: none;
        border: none;
        padding: 0;
        color: inherit;
        font: inherit;
        cursor: pointer;
        opacity: 0.6;
    }

    .categorias button:hover,
    .categorias button.ativo {
        opacity: 1;
    }

    .categorias button.ativo {
        font-weight: bold;
    }

    .livro[hidden] {
        display: none;
    }

    .imagem-container {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        height: 280px;
    }

    .imagem-container img {
        display: block;
        width: auto;
        height: auto;
        max-width: 180px;
        max-height: 270px;
        object-fit: contain;
        border: 4px solid #718b75;
        border-radius: 5px;
        box-sizing: border-box;
    }

    .livros {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 2rem;
    }

    .informacoes h3 {
        font-size: 1rem;
        margin-bottom: 0.3rem;
    }

    .informacoes p {
        font-size: 0.85rem;
        opacity: 0.7;
    }

    .informacoes span {
        font-size: 0.8rem;
        opacity: 0.6;
    }
    @media (max-width: 650px) {
        .imagem-container img {
            max-height: 320px;
        }
    }
</style>
