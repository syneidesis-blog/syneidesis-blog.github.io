---

<Base title="Biblioteca | Syneidesis">
    <main class="biblioteca">
        <nav class="categorias">
            <button class="ativo" data-filtro="Todos">
                Todos
            </button>
            <button data-filtro="Lido">Lidos</button>
            <button data-filtro="Lendo">Lendo</button>
            <button data-filtro="Quero ler">Quero ler</button>
        </nav>

        <div class="pesquisa">
            <input
                type="search"
                id="pesquisar-livros"
                placeholder="Pesquisar livros ou autores..."
                aria-label="Pesquisar livros ou autores"
            />
        </div>

        <section class="estante">
            <h2>Minha estante</h2>

            <div class="livros">
                {livros.map((livro) => (
                    <article class="livro" data-status={livro.status}>
                        <div class="imagem-container">
                            <img
                                src={livro.capa}
                                alt={`Capa de ${livro.titulo}`}
                            />
                        </div>

                        <div class="informacoes">
                            <h3>{livro.titulo}</h3>
                            <p>{livro.autor}</p>

                            {livro.avaliacao !== null && (
                                <div
                                    class="avaliacao"
                                    aria-label={`Nota: ${livro.avaliacao} de 5 estrelas`}
                                >
                                    {Array.from({ length: 5 }, (_, i) => {
                                        const valor = livro.avaliacao - i;

                                        return (
                                            <span
                                                class={`estrela ${valor >= 1 ? "preenchida" : valor >= 0.5 ? "meia" : ""}`}
                                            >
                                                ★
                                            </span>
                                        );
                                    })}
                                </div>
                            )}

                            <span>{livro.status}</span>
                        </div>
                    </article>
                ))}
            </div>
        </section>
    </main>
</Base>

<script>
    const botoes = document.querySelectorAll(".categorias button");
    const livros = document.querySelectorAll(".livro");
    const pesquisa = document.querySelector("#pesquisar-livros");

    let filtroAtual = "Todos";

    function atualizarLivros() {
        const termo = pesquisa.value.toLowerCase().trim();

        livros.forEach((livro) => {
            const status = livro.getAttribute("data-status");
            const titulo = livro.querySelector("h3").textContent.toLowerCase();
            const autor = livro.querySelector("p").textContent.toLowerCase();

            const correspondeStatus =
                filtroAtual === "Todos" || status === filtroAtual;

            const correspondePesquisa =
                titulo.includes(termo) || autor.includes(termo);

            livro.hidden = !(correspondeStatus && correspondePesquisa);
        });
    }

    botoes.forEach((botao) => {
        botao.addEventListener("click", () => {
            filtroAtual = botao.dataset.filtro;

            botoes.forEach((b) => b.classList.remove("ativo"));
            botao.classList.add("ativo");

            atualizarLivros();
        });
    });

    pesquisa.addEventListener("input", atualizarLivros);
</script>
<style>
    .biblioteca {
        max-width: 100%;
    }

    header {
        margin-bottom: 2rem;
    }

    header p {
        opacity: 0.7;
    }

    .categorias {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
        margin-bottom: 3rem;
        border-bottom: 1px solid var(--border-color, #8884);
        padding-bottom: 1rem;
    }

    .categorias button {
        background: none;
        border: none;
        padding: 0;
        color: inherit;
        font: inherit;
        cursor: pointer;
        opacity: 0.6;
    }

    .categorias button:hover,
    .categorias button.ativo {
        opacity: 1;
    }

    .categorias button.ativo {
        font-weight: bold;
    }

    .pesquisa {
        margin-bottom: 2rem;
    }

    .pesquisa input {
        width: 100%;
        max-width: 400px;
        padding: 10px 12px;
        background: transparent;
        border: 1px solid var(--border-color, #8884);
        border-radius: 5px;
        color: inherit;
        font: inherit;
        outline: none;
        box-sizing: border-box;
    }

    .pesquisa input:focus {
        border-color: #718b75;
    }

    .pesquisa input::placeholder {
        opacity: 0.5;
    }

    .livro[hidden] {
        display: none;
    }

    .imagem-container {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        height: 280px;
        margin-bottom: 8px;
    }

    .imagem-container img {
        display: block;
        width: auto;
        height: auto;
        max-width: 180px;
        max-height: 270px;
        object-fit: contain;
        border: 4px solid #718b75;
        border-radius: 5px;
        box-sizing: border-box;
    }

    .livros {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 2rem;
    }

    .informacoes h3 {
        font-size: 1.1rem;
        margin: 0 0 4px;
    }

    .informacoes {
        padding-left: 22px;
    }

    .informacoes p {
        font-size: 0.95rem;
        margin: 0 0 4px;
        opacity: 0.7;
    }

    .informacoes > span {
        display: block;
        font-size: 0.9rem;
        margin-top: 3px;
        opacity: 0.6;
    }

    .avaliacao {
        display: flex;
        gap: 1px;
        margin: 2px 0;
    }

    .estrela {
        font-size: 1.2rem;
        color: #888;
        opacity: 0.35;
        line-height: 1;
    }

    .estrela.preenchida {
        color: #d6a84b;
        opacity: 1;
    }

    .estrela.meia {
        background: linear-gradient(90deg, #d6a84b 50%, #888 50%);
        background-clip: text;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        opacity: 1;
    }

    @media (max-width: 650px) {
        .imagem-container img {
            max-height: 320px;
        }
    }
</style>
