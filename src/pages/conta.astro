---
import Base from "../layouts/Base.astro";
---

<Base title="Minha conta">
    <main>
        <h1>Minha conta</h1>

        <section id="sessao-ativa" hidden>
            <h2>Você está conectado</h2>

            <div class="perfil-avatar">
                <img
                    id="avatar-atual"
                    src=""
                    alt="Foto de perfil"
                    width="120"
                    height="120"
                    hidden
                />
                <span id="avatar-sem-foto" aria-label="Avatar padrão">
                    <svg
                        viewBox="0 0 24 24"
                        xmlns="http://www.w3.org/2000/svg"
                        aria-hidden="true"
                    >
                        <circle cx="12" cy="8" r="4" />
                        <path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8H4z" />
                    </svg>
                </span>
            </div>

            <p id="usuario-atual"></p>

            <form id="form-avatar">
                <label for="avatar-arquivo">Foto de perfil</label>
                <input
                    id="avatar-arquivo"
                    name="avatar"
                    type="file"
                    accept="image/jpeg,image/png,image/webp"
                    required
                />
                <p>JPEG, PNG ou WebP. Tamanho máximo: 2 MB.</p>

                <div id="modal-recorte" hidden>
                    <h3>Ajustar foto</h3>
                    <div class="area-recorte">
                        <img id="imagem-recorte" alt="Prévia para recorte" />
                    </div>

                    <div class="controles-recorte">
                        <button
                            id="zoom-menos"
                            type="button"
                            aria-label="Diminuir zoom"
                        >
                            −
                        </button>
                        <button
                            id="zoom-mais"
                            type="button"
                            aria-label="Aumentar zoom"
                        >
                            +
                        </button>
                    </div>

                    <button id="cancelar-recorte" type="button">
                        Cancelar
                    </button>
                    <button id="confirmar-recorte" type="submit">
                        Recortar e enviar
                    </button>
                </div>

                <p id="avatar-status" aria-live="polite"></p>
            </form>

            <button id="botao-sair" type="button">
                Sair da conta
            </button>
        </section>

        <section id="autenticacao">
            <h2>Entre na sua conta</h2>

            <button id="botao-google" type="button">
                <svg
                    viewBox="0 0 48 48"
                    width="22"
                    height="22"
                    aria-hidden="true"
                >
                    <path
                        fill="#4285F4"
                        d="M43.6 24.5c0-1.4-.1-2.8-.4-4.1H24v7.8h11a9.4 9.4 0 0 1-4.1 6.2v5.1h6.6c3.9-3.6 6.1-8.8 6.1-15z"
                    />
                    <path
                        fill="#34A853"
                        d="M24 44c5.5 0 10.1-1.8 13.5-4.9l-6.6-5.1c-1.8 1.2-4.1 2-6.9 2-5.3 0-9.8-3.6-11.4-8.4H5.8v5.3A20 20 0 0 0 24 44z"
                    />
                    <path
                        fill="#FBBC05"
                        d="M12.6 27.6a12 12 0 0 1 0-7.2v-5.3H5.8a20 20 0 0 0 0 17.8z"
                    />
                    <path
                        fill="#EA4335"
                        d="M24 12.1c3 0 5.7 1 7.8 3.1l5.8-5.8C34.1 6 29.5 4 24 4A20 20 0 0 0 5.8 15.1l6.8 5.3c1.6-4.7 6.1-8.3 11.4-8.3z"
                    />
                </svg>
                <span>Continuar com Google</span>
            </button>

            <p id="google-status" aria-live="polite"></p>
        </section>
    </main>
</Base>

<style>
    main {
        width: min(100% - 2rem, 680px);
        margin: 4rem auto;
        color: #263d3a;
    }

    main > h1 {
        margin-bottom: 2rem;
        font-size: clamp(2rem, 5vw, 2.8rem);
        font-weight: 600;
        letter-spacing: -0.04em;
    }

    #sessao-ativa,
    #autenticacao {
        padding: clamp(1.5rem, 5vw, 2.5rem);
        border: 1px solid #c4d2d0;
        border-radius: 12px;
        background: #eef0e9;
    }

    #sessao-ativa h2,
    #autenticacao h2 {
        margin-top: 0;
        margin-bottom: 1.5rem;
        font-size: 1.4rem;
        font-weight: 500;
    }

    #usuario-atual {
        margin: 1rem 0 2rem;
        color: #49645d;
        font-size: 1.05rem;
    }

    .perfil-avatar {
        width: 120px;
        height: 120px;
        margin: 1.5rem 0;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid #c4d2d0;
        border-radius: 50%;
        background: #c4d2d0;
    }

    .perfil-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    #avatar-sem-foto {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    #avatar-sem-foto svg {
        width: 72px;
        height: 72px;
        fill: #49645d;
    }

    #avatar-sem-foto[hidden] {
        display: none;
    }

    #form-avatar {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.75rem;
        padding: 1.5rem 0;
        border-top: 1px solid #c4d2d0;
    }

    #form-avatar label {
        font-weight: 600;
    }

    #form-avatar input[type="file"] {
        max-width: 100%;
        padding: 0.7rem;
        border: 1px solid #c4d2d0;
        border-radius: 6px;
        background: #fff;
        color: #263d3a;
        font: inherit;
    }

    #form-avatar > p {
        margin: 0;
        color: #49645d;
        font-size: 0.85rem;
    }

    button {
        min-height: 44px;
        padding: 0.75rem 1.25rem;
        border: 1px solid #49645d;
        border-radius: 6px;
        background: #49645d;
        color: #fff;
        font: inherit;
        font-weight: 500;
        cursor: pointer;
        transition: background 180ms ease;
    }

    button:hover {
        background: #263d3a;
    }

    button:focus-visible,
    input:focus-visible {
        outline: 3px solid #a9c5c0;
        outline-offset: 3px;
    }

    button:disabled {
        cursor: wait;
        opacity: 0.6;
    }

    #botao-google {
        display: flex;
        width: 100%;
        min-height: 52px;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding: 12px 20px;
        border: none;
        border-radius: 6px;
        background: #db4437;
        color: #fff;
        font-size: 1rem;
        font-weight: 600;
    }

    #botao-google:hover {
        background: #c1352b;
    }

    #botao-google svg {
        flex-shrink: 0;
    }

    #google-status,
    #avatar-status {
        min-height: 1.4em;
        margin-top: 1rem;
        color: #49645d;
        font-size: 0.9rem;
    }

    #botao-sair {
        border-color: #c4d2d0;
        background: transparent;
        color: #49645d;
    }

    #botao-sair:hover {
        background: #c4d2d0;
    }

    #modal-recorte {
        width: 100%;
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid #c4d2d0;
    }

    #modal-recorte h3 {
        font-weight: 500;
    }

    .area-recorte {
        width: 100%;
        max-height: 400px;
        overflow: hidden;
        border-radius: 6px;
        background: #263d3a;
    }

    .area-recorte img {
        display: block;
        max-width: 100%;
    }

    .controles-recorte {
        display: flex;
        gap: 0.5rem;
        margin: 1rem 0;
    }

    .controles-recorte button {
        width: 44px;
        padding: 0;
        font-size: 1.3rem;
    }

    #modal-recorte button {
        margin-right: 0.4rem;
    }

    #modal-recorte #cancelar-recorte {
        border-color: #c4d2d0;
        background: transparent;
        color: #49645d;
    }

    #modal-recorte #cancelar-recorte:hover {
        background: #c4d2d0;
    }

    @media (max-width: 480px) {
        main {
            margin: 2rem auto;
        }

        #sessao-ativa,
        #autenticacao {
            padding: 1.5rem;
        }
    }
</style>

<script>
    import { authClient } from "../lib/auth";
    import Cropper from "cropperjs";
    import "cropperjs/dist/cropper.css";

    const API = "https://api.syneidesis.com.br";

    const autenticacao = document.querySelector("#autenticacao");
    const botaoGoogle = document.querySelector("#botao-google");
    const googleStatus = document.querySelector("#google-status");

    const sessaoAtiva = document.querySelector("#sessao-ativa");
    const usuarioAtual = document.querySelector("#usuario-atual");
    const botaoSair = document.querySelector("#botao-sair");

    const formAvatar = document.querySelector("#form-avatar");
    const arquivoAvatar = document.querySelector("#avatar-arquivo");
    const avatarAtual = document.querySelector("#avatar-atual");
    const avatarSemFoto = document.querySelector("#avatar-sem-foto");
    const avatarStatus = document.querySelector("#avatar-status");

    const modalRecorte = document.querySelector("#modal-recorte");
    const imagemRecorte = document.querySelector("#imagem-recorte");
    const botaoCancelarRecorte = document.querySelector("#cancelar-recorte");
    const botaoZoomMais = document.querySelector("#zoom-mais");
    const botaoZoomMenos = document.querySelector("#zoom-menos");

    let cropper = null;
    let urlImagem = null;

    function destruirCropper() {
        if (cropper) {
            cropper.destroy();
            cropper = null;
        }

        if (urlImagem) {
            URL.revokeObjectURL(urlImagem);
            urlImagem = null;
        }
    }

    function fecharRecorte() {
        modalRecorte.hidden = true;
        destruirCropper();
        imagemRecorte.removeAttribute("src");
        arquivoAvatar.value = "";
    }

    async function atualizarSessao() {
        const { data } = await authClient.getSession();

        if (data?.user) {
            sessaoAtiva.hidden = false;
            autenticacao.hidden = true;

            usuarioAtual.textContent = `Olá, ${data.user.username || data.user.name}!`;

            if (data.user.image) {
                avatarAtual.src = data.user.image;
                avatarAtual.hidden = false;
                avatarSemFoto.hidden = true;
            } else {
                avatarAtual.hidden = true;
                avatarSemFoto.hidden = false;
            }
        } else {
            sessaoAtiva.hidden = true;
            autenticacao.hidden = false;
        }

        return data?.user || null;
    }

    atualizarSessao();

    botaoGoogle?.addEventListener("click", async () => {
        googleStatus.textContent = "Conectando ao Google...";
        botaoGoogle.disabled = true;

        const { error } = await authClient.signIn.social({
            provider: "google",
            callbackURL: window.location.href,
        });

        if (error) {
            googleStatus.textContent =
                error.message || "Não foi possível entrar com o Google.";

            botaoGoogle.disabled = false;
        }
    });

    botaoSair?.addEventListener("click", async () => {
        await authClient.signOut();
        window.location.reload();
    });

    arquivoAvatar?.addEventListener("change", () => {
        const arquivo = arquivoAvatar.files?.[0];

        if (!arquivo) return;

        const formatos = ["image/jpeg", "image/png", "image/webp"];

        if (!formatos.includes(arquivo.type)) {
            avatarStatus.textContent = "Escolha uma imagem JPEG, PNG ou WebP.";
            arquivoAvatar.value = "";
            return;
        }

        if (arquivo.size > 2 * 1024 * 1024) {
            avatarStatus.textContent = "A imagem deve ter no máximo 2 MB.";
            arquivoAvatar.value = "";
            return;
        }

        destruirCropper();

        urlImagem = URL.createObjectURL(arquivo);
        imagemRecorte.src = urlImagem;
        modalRecorte.hidden = false;
        avatarStatus.textContent = "Ajuste a imagem e confirme o recorte.";

        imagemRecorte.onload = () => {
            cropper = new Cropper(imagemRecorte, {
                aspectRatio: 1,
                viewMode: 1,
                dragMode: "move",
                autoCropArea: 1,
                responsive: true,
                background: false,
                zoomable: true,
                scalable: false,
                rotatable: false,
                guides: true,
                center: true,
                cropBoxMovable: false,
                cropBoxResizable: false,
            });
        };
    });

    botaoZoomMais?.addEventListener("click", () => {
        cropper?.zoom(0.1);
    });

    botaoZoomMenos?.addEventListener("click", () => {
        cropper?.zoom(-0.1);
    });

    botaoCancelarRecorte?.addEventListener("click", () => {
        fecharRecorte();
        avatarStatus.textContent = "Recorte cancelado.";
    });

    function criarBlob(canvas, qualidade = 0.9) {
        return new Promise((resolve) => {
            canvas.toBlob(resolve, "image/jpeg", qualidade);
        });
    }

    formAvatar?.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (!cropper) {
            avatarStatus.textContent = "Selecione uma imagem primeiro.";
            return;
        }

        avatarStatus.textContent = "Preparando imagem...";

        try {
            const canvas = cropper.getCroppedCanvas({
                width: 512,
                height: 512,
                imageSmoothingEnabled: true,
                imageSmoothingQuality: "high",
            });

            let blob = await criarBlob(canvas, 0.9);

            if (!blob) {
                throw new Error("Não foi possível recortar a imagem.");
            }

            if (blob.size > 2 * 1024 * 1024) {
                blob = await criarBlob(canvas, 0.7);
            }

            if (!blob || blob.size > 2 * 1024 * 1024) {
                throw new Error(
                    "Não foi possível reduzir a imagem para menos de 2 MB.",
                );
            }

            avatarStatus.textContent = "Enviando foto...";

            const resposta = await fetch(`${API}/avatar`, {
                method: "POST",
                credentials: "include",
                headers: {
                    "Content-Type": "image/jpeg",
                },
                body: blob,
            });

            const resultado = await resposta.json();

            if (!resposta.ok) {
                throw new Error(
                    resultado.error || "Não foi possível enviar a foto.",
                );
            }

            avatarStatus.textContent = "Foto atualizada com sucesso!";

            avatarAtual.src = resultado.image;
            avatarAtual.hidden = false;
            avatarSemFoto.hidden = true;

            fecharRecorte();
            await atualizarSessao();
        } catch (error) {
            avatarStatus.textContent =
                error.message || "Erro ao enviar a foto.";
        }
    });
</script>
