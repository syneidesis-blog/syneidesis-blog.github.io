const categorias = ["All", "Read", "Reading", "Want to Read"];
---

<Base title="My Bookshelf | Syneidesis" lang="en">
    <main class="biblioteca">
        <nav class="categorias">
            <button class="ativo" data-filtro="All">
                All
            </button>
            <button data-filtro="Read">Read</button>
            <button data-filtro="Reading">Reading</button>
            <button data-filtro="Want to Read">Want to Read</button>
        </nav>

        <section class="estante">
            <h2>My bookshelf</h2>

            <div class="livros">
                {livros.map((livro) => (
                    <article class="livro" data-status={livro.status}>
                        <div class="imagem-container">
                            <img
                                src={livro.cover}
                                alt={`Cover of ${livro.title}`}
                            />
                        </div>

                        <div class="informacoes">
                            <h3>{livro.title}</h3>
                            <p>{livro.author}</p>

                            {livro.rating !== null && (
                                <div
                                    class="avaliacao"
                                    aria-label={`Rating: ${livro.rating} out of 5 stars`}
                                >
                                    {Array.from({ length: 5 }, (_, i) => {
                                        const valor = livro.rating - i;

                                        return (
                                            <span
                                                class={`estrela ${valor >= 1 ? "preenchida" : valor >= 0.5 ? "meia" : ""}`}
                                            >
                                                ★
                                            </span>
                                        );
                                    })}
                                </div>
                            )}

                            <span>{livro.status}</span>
                        </div>
                    </article>
                ))}
            </div>
        </section>
    </main>
</Base>

<script>
    const botoes = document.querySelectorAll(".categorias button");
    const livros = document.querySelectorAll(".livro");

    botoes.forEach((botao) => {
        botao.addEventListener("click", () => {
            const filtro = botao.dataset.filtro;

            botoes.forEach((b) => b.classList.remove("ativo"));
            botao.classList.add("ativo");

            livros.forEach((livro) => {
                const status = livro.getAttribute("data-status");

                livro.hidden = filtro !== "All" && status !== filtro;
            });
        });
    });
</script>

<style>
    .biblioteca {
        max-width: 100%;
    }

    header {
        margin-bottom: 2rem;
    }

    header p {
        opacity: 0.7;
    }

    .categorias {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
        margin-bottom: 3rem;
        border-bottom: 1px solid var(--border-color, #8884);
        padding-bottom: 1rem;
    }

    .categorias button {
        background: none;
        border: none;
        padding: 0;
        color: inherit;
        font: inherit;
        cursor: pointer;
        opacity: 0.6;
    }

    .categorias button:hover,
    .categorias button.ativo {
        opacity: 1;
    }

    .categorias button.ativo {
        font-weight: bold;
    }

    .livro[hidden] {
        display: none;
    }

    .imagem-container {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        height: 280px;
        margin-bottom: 8px;
    }

    .imagem-container img {
        display: block;
        width: auto;
        height: auto;
        max-width: 180px;
        max-height: 270px;
        object-fit: contain;
        border: 4px solid #718b75;
        border-radius: 5px;
        box-sizing: border-box;
    }

    .livros {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 2rem;
    }

    .informacoes h3 {
        font-size: 1.1rem;
        margin: 0 0 4px;
    }

    .informacoes {
        padding-left: 22px;
    }

    .informacoes p {
        font-size: 0.95rem;
        margin: 0 0 4px;
        opacity: 0.7;
    }

    .informacoes > span {
        display: block;
        font-size: 0.9rem;
        margin-top: 3px;
        opacity: 0.6;
    }

    .avaliacao {
        display: flex;
        gap: 1px;
        margin: 2px 0;
    }

    .estrela {
        font-size: 1.2rem;
        color: #888;
        opacity: 0.35;
        line-height: 1;
    }

    .estrela.preenchida {
        color: #d6a84b;
        opacity: 1;
    }

    .estrela.meia {
        background: linear-gradient(90deg, #d6a84b 50%, #888 50%);
        background-clip: text;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        opacity: 1;
    }

    @media (max-width: 650px) {
        .imagem-container img {
            max-height: 320px;
        }
    }
</style>
