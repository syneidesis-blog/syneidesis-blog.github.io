---
const { title = "Syneidesis", lang = "pt" } = Astro.props;

const iconesMenu = [
    "home.png",
    "file.png",
    "writing.png",
    "art.png",
    "video.png",
    "camera-roll.png",
    "book.png",
    "info.png",
    "mail.png",
];

const menus = {
    pt: [
        ["Início", "/"],
        ["Artigos", "/artigos/"],
        ["Poemas", "/poemas/"],
        ["Galeria", "/desenhos/"],
        ["Álbum", "/fotos/"],
        ["Filmoteca", "/destaques/"],
        ["Biblioteca", "/leituras/"],
        ["Sobre", "/sobre/"],
        ["Assinar", "/correspondentia/"],
    ],
    en: [
        ["Home", "/en/"],
        ["Articles", "/en/articles/"],
        ["Poems", "/en/poems/"],
        ["Gallery", "/en/drawings/"],
        ["Album", "/en/photos/"],
        ["Film Library", "/en/highlights/"],
        ["Library", "/en/readings/"],
        ["About", "/en/about/"],
        ["Subscribe", "/en/correspondentia/"],
    ],
};

const idioma = lang === "en" ? "en" : "pt";

const canonicalUrl = new URL(Astro.url.pathname, "https://syneidesis.com.br")
    .href;

const equivalencias = {
    "/": { pt: "/", en: "/en/" },
    "/artigos": { pt: "/artigos/", en: "/en/articles/" },
    "/poemas": { pt: "/poemas/", en: "/en/poems/" },
    "/desenhos": { pt: "/desenhos/", en: "/en/drawings/" },
    "/fotos": { pt: "/fotos/", en: "/en/photos/" },
    "/destaques": { pt: "/destaques/", en: "/en/highlights/" },
    "/leituras": { pt: "/leituras/", en: "/en/readings/" },
    "/sobre": { pt: "/sobre/", en: "/en/about/" },
    "/correspondentia": {
        pt: "/correspondentia/",
        en: "/en/correspondentia/",
    },
    "/artigo.html": {
        pt: "/artigo.html",
        en: "/en/article.html",
    },
    "/en": { pt: "/", en: "/en/" },
    "/en/articles": { pt: "/artigos/", en: "/en/articles/" },
    "/en/poems": { pt: "/poemas/", en: "/en/poems/" },
    "/en/drawings": { pt: "/desenhos/", en: "/en/drawings/" },
    "/en/photos": { pt: "/fotos/", en: "/en/photos/" },
    "/en/highlights": { pt: "/destaques/", en: "/en/highlights/" },
    "/en/readings": { pt: "/leituras/", en: "/en/readings/" },
    "/en/about": { pt: "/sobre/", en: "/en/about/" },
    "/en/correspondentia": {
        pt: "/correspondentia/",
        en: "/en/correspondentia/",
    },
    "/en/article.html": {
        pt: "/artigo.html",
        en: "/en/article.html",
    },
};

const caminhoAtual = Astro.url.pathname.replace(/\/+$/, "") || "/";
const rotas = equivalencias[caminhoAtual] || {
    pt: "/",
    en: "/en/",
};

const caminhoPT = rotas.pt;
const caminhoEN = rotas.en;

const rotaAtiva =
    caminhoAtual === "/artigo.html"
        ? "/artigos"
        : caminhoAtual === "/en/article.html"
          ? "/en/articles"
          : caminhoAtual;

const parametros = new URLSearchParams(Astro.url.search);

const categorias = {
    articles: "artigos",
    poems: "poemas",
    artigos: "articles",
    poemas: "poems",
};

if (parametros.has("categoria")) {
    const categoria = categorias[parametros.get("categoria")];

    if (categoria) {
        parametros.set("categoria", categoria);
    }
}

const busca = parametros.toString() ? `?${parametros.toString()}` : "";
---

<!doctype html>
<html lang={idioma === "en" ? "en" : "pt-BR"}>
    <head>
        <meta charset="UTF-8" />
        <meta
            name="google-site-verification"
            content="obp8sG8Nrcxe8Dcrg2g1HE8MPcykibn2QRvGI1s3tBY"
        />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <link rel="stylesheet" href="/style.css" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=DynaPuff:wght@400..700&family=UnifrakturCook:wght@700&display=swap"
            rel="stylesheet"
        />
        <link rel="canonical" href={canonicalUrl} />
        <link
            rel="icon"
            type="image/png"
            href="/imagens/Forest%20Green%20S%20Triangle%20Emblem.png"
        />
    </head>

    <body>
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-top">
                <a href={idioma === "en" ? "/en/" : "/"}>
                    <img
                        id="tituloimg"
                        src="/imagens/title.png"
                        alt="Syneidesis"
                    />
                </a>

                <button
                    class="sidebar-toggle"
                    id="sidebar-toggle"
                    type="button"
                    aria-label="Recolher ou expandir menu"
                    aria-expanded="true"
                >
                    ☰
                </button>
            </div>

            <nav class="menu" aria-label="Navegação principal">
                {menus[idioma].map(([label, url], index) => {
                    const caminhoMenu =
                        new URL(url, Astro.url).pathname.replace(/\/+$/, "") ||
                        "/";

                    const paginaAtiva = caminhoMenu === rotaAtiva;

                    return (
                        <a
                            href={url}
                            aria-current={paginaAtiva ? "page" : undefined}
                        >
                            <span class="menu-icon" aria-hidden="true">
                                <img
                                    src={`/imagens/${iconesMenu[index]}`}
                                    alt=""
                                />
                            </span>
                            <span class="menu-label">{label}</span>
                        </a>
                    );
                })}
            </nav>

            <div class="sidebar-bottom">
                <a
                    id="idioma-pt"
                    href={`${caminhoPT}${busca}`}
                    aria-label="Português"
                    aria-current={idioma === "pt" ? "page" : undefined}
                >
                    <img src="/imagens/brazil-flag-icon.webp" alt="Português" />
                </a>

                <a
                    id="idioma-en"
                    href={`${caminhoEN}${busca}`}
                    aria-label="English"
                    aria-current={idioma === "en" ? "page" : undefined}
                >
                    <img
                        src="/imagens/united-kingdom-flag-icon.png"
                        alt="English"
                    />
                </a>
            </div>
        </aside>

        <main>
            <div class="site-intro">
                <a href={idioma === "en" ? "/en/" : "/"}>
                    <img
                        class="site-intro-logo"
                        src="/imagens/title.png"
                        alt="Syneidesis"
                    />
                </a>
                <p>
                    {idioma === "en"
                        ? "Philosophy, art and culture"
                        : "Filosofia, arte e cultura"}
                </p>

                <div class="site-intro-linha"></div>
            </div>

            <slot />
        </main>

        <footer>
            {idioma === "en"
                ? "© 2026 Syneidesis. All rights reserved."
                : "© 2026 Syneidesis. Todos os direitos reservados."}
        </footer>

        <script is:inline>
            const equivalenciasIdioma = {
                "/": { pt: "/", en: "/en/" },
                "/artigos": { pt: "/artigos/", en: "/en/articles/" },
                "/poemas": { pt: "/poemas/", en: "/en/poems/" },
                "/desenhos": { pt: "/desenhos/", en: "/en/drawings/" },
                "/fotos": { pt: "/fotos/", en: "/en/photos/" },
                "/destaques": { pt: "/destaques/", en: "/en/highlights/" },
                "/leituras": { pt: "/leituras/", en: "/en/readings/" },
                "/sobre": { pt: "/sobre/", en: "/en/about/" },
                "/correspondentia": {
                    pt: "/correspondentia/",
                    en: "/en/correspondentia/",
                },
                "/artigo.html": {
                    pt: "/artigo.html",
                    en: "/en/article.html",
                },
                "/en": { pt: "/", en: "/en/" },
                "/en/articles": { pt: "/artigos/", en: "/en/articles/" },
                "/en/poems": { pt: "/poemas/", en: "/en/poems/" },
                "/en/drawings": { pt: "/desenhos/", en: "/en/drawings/" },
                "/en/photos": { pt: "/fotos/", en: "/en/photos/" },
                "/en/highlights": { pt: "/destaques/", en: "/en/highlights/" },
                "/en/readings": { pt: "/leituras/", en: "/en/readings/" },
                "/en/about": { pt: "/sobre/", en: "/en/about/" },
                "/en/correspondentia": {
                    pt: "/correspondentia/",
                    en: "/en/correspondentia/",
                },
                "/en/article.html": {
                    pt: "/artigo.html",
                    en: "/en/article.html",
                },
            };

            const caminho = window.location.pathname.replace(/\/+$/, "") || "/";
            const rotas = equivalenciasIdioma[caminho] || {
                pt: "/",
                en: "/en/",
            };

            const categoriasIdioma = {
                articles: "artigos",
                poems: "poemas",
                artigos: "articles",
                poemas: "poems",
            };

            function montarLink(destino) {
                const parametros = new URLSearchParams(window.location.search);

                if (parametros.has("categoria")) {
                    const categoria = parametros.get("categoria");
                    const categoriaTraduzida = categoriasIdioma[categoria];

                    if (categoriaTraduzida) {
                        parametros.set("categoria", categoriaTraduzida);
                    }
                }

                const busca = parametros.toString();
                return destino + (busca ? "?" + busca : "");
            }

            const botaoPT = document.querySelector("#idioma-pt");
            const botaoEN = document.querySelector("#idioma-en");

            botaoPT.href = montarLink(rotas.pt);
            botaoEN.href = montarLink(rotas.en);

            if (document.documentElement.lang === "pt-BR") {
                botaoPT.addEventListener("click", (evento) => {
                    evento.preventDefault();
                });
            }

            if (document.documentElement.lang === "en") {
                botaoEN.addEventListener("click", (evento) => {
                    evento.preventDefault();
                });
            }

            // Controle da sidebar.
            const sidebar = document.querySelector("#sidebar");
            const toggle = document.querySelector("#sidebar-toggle");

            const menuRecolhido =
                localStorage.getItem("menuRecolhido") === "true";

            if (menuRecolhido) {
                sidebar.classList.add("recolhida");
                document.body.classList.add("menu-recolhido");
                toggle.setAttribute("aria-expanded", "false");
            }

            toggle.addEventListener("click", () => {
                const recolhida = sidebar.classList.toggle("recolhida");

                document.body.classList.toggle("menu-recolhido", recolhida);

                localStorage.setItem("menuRecolhido", recolhida);

                toggle.setAttribute("aria-expanded", String(!recolhida));
            });
        </script>
    </body>
</html>
